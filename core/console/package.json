{
  "name": "console-pir",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint --cache src/",
    "lint:fix": "eslint --cache --fix src/",
    "lint:suppress": "eslint --fix --suppress-all src/",
    "lint:prune": "eslint --prune-suppressions --pass-on-unpruned-suppressions src/",
    "test": "vitest",
    "test:run": "vitest run",
    "test:build-id": "node --test scripts/console-build-id.node-test.mjs",
    "audit:production": "npm audit --omit=dev --audit-level=low",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "knip": "knip --cache",
    "knip:check": "node scripts/knip-check.mjs",
    "knip:baseline": "node scripts/knip-count.mjs > .knip-baseline.json",
    "gen:types": "node scripts/gen-types.mjs"
  },
