#!/usr/bin/env node
import { execSync } from 'node:child_process'

function runEslint() {
  try {
    return execSync('node_modules/.bin/eslint . --format json', {
      encoding: 'utf8',
      maxBuffer: 20 * 1024 * 1024,
      stdio: ['pipe', 'pipe', 'pipe'],
    })
  } catch (error) {
    const output = error.stdout || ''
    if (!output) {
      console.error('ESLint produced no JSON output:', error.stderr || error.message)
      process.exit(2)
    }
    return output
  }
}

function summarize(results) {
  const summary = {
    schemaVersion: 1,
    generatedAt: new Date().toISOString(),
    totals: { errors: 0, warnings: 0 },
    rules: {},
  }

  for (const file of results) {
    summary.totals.errors += file.errorCount ?? 0
    summary.totals.warnings += file.warningCount ?? 0

    for (const message of file.messages ?? []) {
      const ruleId = message.ruleId || '<unknown>'
      if (!summary.rules[ruleId]) {
        summary.rules[ruleId] = { errors: 0, warnings: 0 }
      }
      if (message.severity === 2) {
        summary.rules[ruleId].errors += 1
      } else if (message.severity === 1) {
        summary.rules[ruleId].warnings += 1
      }
    }
  }

  return summary
}

const parsed = JSON.parse(runEslint())
process.stdout.write(`${JSON.stringify(summarize(parsed), null, 2)}\n`)
