# by Emilio's decision — the leak vector that justified it (auto public mirror on
# push) was removed by U4, and this unified main is the single engine truth. The
# old clause forbidding synchronization is superseded; the public mirror remains
# frozen and separately governed.
contract_version: 3
lineage: unified-main
openapi: "3.1.0"
engine_ref: ac38759e07ec53024498da24ceedfce23e0c8b0e
predecessor_contract_version: 2
