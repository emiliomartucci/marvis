# Profile (ratified by owner 2026-07-27): the governed contract covers all public,
# discoverable routes registered in the app, optional routers included. Historical
# browser file-mutation routes are intentionally agent-only and non-discoverable;
# they remain runtime-served for internal bearer clients, preserving N/N-1 runtime
# compatibility while no longer advertising a browser mutation surface.
profile: all-surfaces
# Breaking-change policy (ratified by owner 2026-07-27): the oasdiff gate fails hard
# on any breaking change (--fail-on ERR). Intentional breaks go through deprecation:
# compatibility window N/N-1 — the current and previous contract versions stay served
# for one release cycle before removal.
breaking_gate: hard-fail
compatibility_window: N/N-1
# The spec is coupled to the resolved FastAPI/pydantic versions. Regenerate under the
# same dep set the CI gate installs: requirements-tenant.txt (the production API image
# manifest) — see .github/workflows/openapi-diff.yml.
coupled_to: requirements-tenant.txt
