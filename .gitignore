# OS
.DS_Store

# Environment
.env
.env.*
!.env.example
!**/.env.example
!.env.*.example
!**/.env.*.example

# Binary files (not tracked)
*.pdf
*.PDF
*.xlsx
*.XLSX
*.docx
*.DOCX
*.png
# PWA icons of the local Console MUST ship: the public mirror re-commits the
# tree under THIS gitignore, so without the negation the icons silently drop
# from the mirror -> Next export -> wheel (manifest 404s, beta 0.3.9b1).
!core/console/public/icons/*.png
!core/api/console_dist/icons/*.png
*.jpg
*.jpeg
*.gif
*.mp4
*.zip

# Python
__pycache__/
.import_linter_cache/

# Node (mcp-pir local install — installed via npm install in deploy)
node_modules/
apps/docs/.next/
apps/docs/.source/
apps/docs/tsconfig.tsbuildinfo

# Test
test-results/
pytest-of-*/
docs/audits/kg-probe-*.json
console.db
console.db-shm
console.db-wal
console/.git.bak/

.gemini/
gha-creds-*.json
