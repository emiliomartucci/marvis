# Copia questo file in .env. I valori tra << >> sono segnaposto: sostituiscili
# prima di esporre l'istanza su Internet. Le sezioni segnate (opt) servono solo
# se attivi il profilo corrispondente o usi quella integrazione.

# =============================================================================
# CORE — required for boot
# =============================================================================

# Nome progetto Docker Compose. Cambialo se avvii piu' istanze sulla stessa macchina.
COMPOSE_PROJECT_NAME=marvis-template

# Tag locale delle immagini buildate da Docker Compose.
MARVIS_IMAGE_TAG=local

# Porta HTTP pubblicata dalla API sul tuo host.
API_PORT=8100

# Porta HTTP pubblicata dalla Console sul tuo host.
CONSOLE_PORT=3000

# Porta HTTP pubblicata da nginx sul tuo host (reverse proxy baseline).
NGINX_PORT=8080

# Rete interna di questa singola istanza. Se avvii piu' stack sullo stesso host,
# assegna a ciascuno una subnet non sovrapposta e mantieni tutti gli IP dentro
# quella subnet. Compose usa gli IP esatti dei proxy come confine di fiducia.
MARVIS_NETWORK_SUBNET=172.31.251.0/24
MARVIS_API_IPV4=172.31.251.10
MARVIS_CONSOLE_IPV4=172.31.251.11
MARVIS_NGINX_IPV4=172.31.251.20
MARVIS_CLOUDFLARED_IPV4=172.31.251.30
MARVIS_CADDY_IPV4=172.31.251.40

# NOTA rebrand: l'API accetta gia' i nomi MARVIS_* come alias di PIR_*
# (es. MARVIS_DB_PATH, MARVIS_JWT_SECRET, MARVIS_PASSWORD, MARVIS_ADMIN_PASSWORD_HASH,
# MARVIS_ENV, MARVIS_INSTANCE, MARVIS_CANARY_BANNER). I nomi PIR_* qui sotto
# restano pienamente validi: la catena di bootstrap (init.sh/healthcheck/compose)
# li usa ancora, quindi NON rinominarli in questo template finche' quella catena
# non passa a MARVIS_*.

# Ambiente applicativo: development per locale, production per deploy reale.
PIR_ENV=development

# Modalita' runtime generica OSS.
DEPLOY_MODE=core

# Fase funzionale locale. A e' il profilo piu' piccolo.
MARVISX_PHASE=A

# Nome leggibile dell'istanza.
PIR_INSTANCE=local

# Banner canary nella UI. Di solito false per install locale.
PIR_CANARY_BANNER=false


# Motore di ricerca-per-significato. Default: modello Granite locale
# (granite-embedding-97m-multilingual-r2, 384-dim, IT+EN) — nessuna chiave esterna.
EMBEDDING_MODE=granite_local  # granite_local | granite_remote
EMBEDDING_DEVICE=cpu  # cpu | mps | cuda (solo granite_local)
# Floor di RAM: sotto questa soglia `marvis doctor` avvisa (requisito hardware,
# non c'e' downgrade automatico a un modello peggiore).
EMBEDDING_RAM_THRESHOLD_MB=4096

# Percorso SQLite dentro al container API.
PIR_DB_PATH=/data/pir/console.db

# URL SQLite compatibile con script che leggono DATABASE_URL.
DATABASE_URL=sqlite:////data/pir/console.db

# Segreto JWT. Genera un valore reale prima di esporre l'istanza
# (es. openssl rand -hex 32).
PIR_JWT_SECRET=<<JWT_SECRET>>

# Password iniziale locale dell'admin. Cambiala prima di usare dati reali.
PIR_PASSWORD=local-admin-password

# Hash bcrypt alternativo a PIR_PASSWORD. Se vuoto, init.sh calcola l'hash da PIR_PASSWORD.
PIR_ADMIN_PASSWORD_HASH=

# Token API per agenti o automazioni locali.
TASKS_API_TOKEN=<<API_KEY>>

# Dominio cookie. Vuoto va bene per localhost.
COOKIE_DOMAIN=

# Origini CORS di produzione, formato JSON. pydantic_settings esige array JSON.
CORS_ORIGINS_PROD=["https://<<DOMAIN>>"]

# Il preset host accetta X-Marvis-Client-IP solo da Caddy su loopback.
# Il Compose sovrascrive questo valore con gli IP statici esatti dei propri proxy.
TRUSTED_PROXY_CIDRS=["127.0.0.1/32","::1/128"]

# URL pubblico della Console (usato per redirect login).
CONSOLE_BASE_URL=http://localhost:3000

# Durata sessione login in ore.
JWT_EXPIRY_HOURS=24

# Durata dei ticket websocket in secondi.
WS_TICKET_TTL_SECONDS=30

# Timeout SQLite su lock temporanei.
SQLITE_BUSY_TIMEOUT_MS=30000

# Dimensione pool connessioni lettura.
DB_POOL_SIZE=8

# Iberna sessioni CLI inattive quando supportato.
AUTO_HIBERNATE_ENABLED=true

# Rate limit task per minuto.
TASKS_RATE_LIMIT_PER_MIN=60

# Rate limit richieste Knowledge Graph profonde per minuto.
KG_DEEP_RATE_LIMIT_PER_MIN=30

# Radice file esposta dal Finder (path interno al container).
FINDER_ROOT=/data/workspace

# Radice workspace usata da sessioni e Finder (path interno al container).
WORKSPACE_ROOT=/data/workspace

# Radice da cui condividere repository o file (path interno al container).
REPO_SHARE_ROOT=/data/workspace

# Home runtime dentro al container.
RUNTIME_HOME=/data/runtime

# Directory identita' agenti dentro al container.
AGENTS_BASE=/data/runtime/agents

# Percorso regole operative caricate dagli agenti.
CONSTITUTION_PATH=/app/.config/marvis/constitution.md

# Dimensione massima upload Finder in byte.
FINDER_MAX_UPLOAD_BYTES=50000000

# Dimensione massima edit file Finder in byte.
FINDER_MAX_EDIT_BYTES=1000000

# Dimensione massima preview file Finder in byte.
FINDER_MAX_VIEW_BYTES=10000000

# Espone /docs e /openapi.json.
EXPOSE_OPENAPI=true

# Limite task in_progress per progetto.
WIP_MAX_IN_PROGRESS=3

# Veto auto-approvazione self-improvement (SAFETY). Array JSON.
# Gli agenti elencati qui NON possono mai auto-approvare i propri task `hybrid`
# di self-improvement: vengono forzati a revisione umana. Default vuoto: nessun
# agente di self-improvement. Imposta gli slug dei tuoi agenti se ne hai.
SELF_IMPROVEMENT_AGENTS=[]

# Identita' agente statiche per l'header X-Agent-Name (attribuzione + scope), in
# aggiunta alla tabella users del DB. Array JSON. Default vuoto: gli agenti si
# autenticano via la loro riga DB. Imposta gli slug se usi il token condiviso.
STATIC_AGENT_IDENTITIES=[]

# Forza cambio password al primo login (utile in deploy condivisi).
FORCE_PASSWORD_CHANGE_ON_FIRST_LOGIN=false

# Seed admin generico creato da scripts/init.sh.
MARVIS_ADMIN_USER_ID=usr_admin
MARVIS_ADMIN_SLUG=admin
MARVIS_ADMIN_DISPLAY_NAME=Admin
MARVIS_ADMIN_EMAIL=admin@example.local

# Team locale creato dal seed minimo.
MARVIS_TEAM_ID=team_local
MARVIS_TEAM_SLUG=local
MARVIS_TEAM_DISPLAY_NAME=Local Team

# =============================================================================
# TUNNEL (opt) — Cloudflare Tunnel
# Attiva con: docker compose --profile tunnel up -d
# =============================================================================

# Token Cloudflare Tunnel. Lascia il segnaposto finche' non abiliti il profilo tunnel.
CLOUDFLARE_TUNNEL_TOKEN=<<API_KEY>>

# Dominio pubblico opzionale usato da Cloudflare.
PUBLIC_DOMAIN=<<DOMAIN>>

# =============================================================================
# CADDY (opt) — reverse proxy con TLS automatica
# Attiva con: docker compose --profile caddy up -d
# Coesiste con nginx baseline (nginx su NGINX_PORT, caddy su 80/443).
# Dev: PUBLIC_DOMAIN=localhost -> Caddy usa CA interna (cert self-signed).
# Prod: PUBLIC_DOMAIN=tuo.dominio + ACME_EMAIL=tua@email -> Let's Encrypt.
# =============================================================================

# Email per l'account Let's Encrypt (ignorata se PUBLIC_DOMAIN=localhost).
ACME_EMAIL=<<EMAIL>>

# Porte host su cui Caddy ascolta (cambia se 80/443 sono gia' occupate).
CADDY_HTTP_PORT=80
CADDY_HTTPS_PORT=443

# =============================================================================
# BYOK LLM (opt) — bring your own keys
# Lascia vuoto o segnaposto se non usi LLM cloud.
# =============================================================================

# Chiave API OpenAI opzionale.
OPENAI_API_KEY=<<API_KEY>>

# Chiave API Anthropic opzionale.
ANTHROPIC_API_KEY=<<API_KEY>>


# Gateway LLM compatibile OpenAI (per LiteLLM, vLLM, ecc.).
LLM_GATEWAY_BASE_URL=https://<<DOMAIN>>/v1
LLM_GATEWAY_ENFORCE_PUBLIC_BASE_URL=false
LLM_GATEWAY_API_KEY=<<API_KEY>>
LLM_GATEWAY_AUX_BASE_URL=https://<<DOMAIN>>

# Base URL LLM generica passata alle sessioni CLI.
LLM_BASE_URL=https://api.anthropic.com/v1

# Modello LLM generico passato alle sessioni CLI.
LLM_MODEL_ID=claude-sonnet-4.5

# Inbox TL;DR — usa modello locale (Mac gateway) o cloud.
INBOX_TLDR_USE_LOCAL=false
INBOX_TLDR_SHADOW_MODE=false
INBOX_TLDR_LOCAL_MODEL=tier-think
INBOX_DEEP_RESEARCH_LOCAL_MODEL=tier-fast
INBOX_DEEP_RESEARCH_LLM_GATEWAY_API_KEY=<<API_KEY>>
INBOX_DEEP_RESEARCH_REPAIR_MODEL=tier-fast
INBOX_DEEP_RESEARCH_LOCAL_MAX_TOKENS=2000
INBOX_DEEP_RESEARCH_LOCAL_TIMEOUT_SECONDS=300

# Ingest classifier LLM (provider=local => Mac gateway).
INGEST_LLM_PROVIDER=local
INGEST_LLM_CLASSIFIER_MODEL=tier-fast
INGEST_LLM_CLASSIFIER_TIMEOUT_SECONDS=30
INGEST_LLM_CLASSIFIER_MAX_CONCURRENCY=4
INGEST_LLM_CLASSIFIER_MAX_ATTEMPTS=3
INGEST_LLM_CLASSIFIER_RETRY_AFTER_CAP_SECONDS=30
INGEST_LLM_GATEWAY_PRIORITY=batch
INGEST_LLM_GATEWAY_INITIAL_POLL_DELAY_SECONDS=1
INGEST_LLM_GATEWAY_API_KEY=<<API_KEY>>
INGEST_LLM_GATEWAY_AGENT_NAME=marvis-ingester

# =============================================================================
# INGEST parsers (opt) — limiti file & timeout
# =============================================================================

INGEST_PARSER_MAX_CONCURRENCY=1
INGEST_LOCAL_PARSER_MAX_CONCURRENCY=1
INGEST_OCR_MAX_CONCURRENCY=3
INGEST_DOCPARSE_MAX_CONCURRENCY=1
INGEST_TRANSCRIBE_MAX_CONCURRENCY=1
INGEST_VISION_MAX_CONCURRENCY=1

INGEST_TRANSCRIBE_TIMEOUT_SECONDS=900
INGEST_TRANSCRIBE_FFMPEG_TIMEOUT_SECONDS=900
INGEST_TRANSCRIBE_MAX_BYTES=524288000
INGEST_TRANSCRIBE_LANGUAGE=

INGEST_OCR_TIMEOUT_SECONDS=300
INGEST_OCR_MAX_BYTES=524288000

INGEST_DOCPARSE_ENABLED=false
INGEST_DOCPARSE_PDFS_ENABLED=true
INGEST_DOCPARSE_IMAGES_ENABLED=true
INGEST_DOCPARSE_MODE=standard
INGEST_DOCPARSE_MODE_OVERRIDE=
INGEST_DOCPARSE_TIMEOUT_SECONDS=900
INGEST_DOCPARSE_MAX_BYTES=524288000

INGEST_VISION_IMAGES_ENABLED=false
INGEST_VISION_TIMEOUT_SECONDS=120
INGEST_VISION_MAX_BYTES=20971520
INGEST_VISION_MAX_TOKENS=900

INGEST_DOCX_MAX_BYTES=26214400

# =============================================================================
# MONITORING (opt) — metrics & retention
# =============================================================================

MONITORING_METRICS_INTERVAL=60
MONITORING_DOCKER_INTERVAL=60
MONITORING_SECURITY_INTERVAL=60
MONITORING_RETENTION_RAW_HOURS=24
MONITORING_RETENTION_CANDLES_DAYS=30
MONITORING_RETENTION_EVENTS_DAYS=30
MONITORING_RATE_LIMIT_PER_MIN=30

# =============================================================================
# INBOX (opt) — sources & limits
# =============================================================================

# Config sorgenti inbox in JSON. Vuoto nel boot minimo.
INBOX_SOURCES_JSON={}
INBOX_MAX_TITLE_CHARS=500
INBOX_MAX_CONTENT_CHARS=20000
INBOX_MAX_METADATA_BYTES=20000
INBOX_DIGEST_SCHEDULER_INTERVAL_SECONDS=3600

# =============================================================================
# BRAIN (opt) — self-reflection layer
# =============================================================================

BRAIN_SCHEDULER_INTERVAL_SECONDS=3600
BRAIN_RUN_OFF_PEAK_ONLY=false

# LLM polish (richiede gateway o ANTHROPIC_API_KEY).
BRAIN_LLM_POLISH_ENABLED=false
BRAIN_LLM_JOURNAL_POLISH_ENABLED=true
BRAIN_LLM_FINDING_SUMMARY_ENABLED=true
BRAIN_LLM_FINDING_REASONING_ENABLED=true
BRAIN_LLM_GATEWAY_BASE_URL=https://<<DOMAIN>>
BRAIN_LLM_GATEWAY_API_KEY=<<API_KEY>>
BRAIN_LLM_TENANT=marvis-brain
BRAIN_LLM_MODEL=tier-write
BRAIN_LLM_POLISH_TIMEOUT_SECONDS=30
BRAIN_LLM_POLISH_CACHE_TTL_SECONDS=3600
BRAIN_LLM_GROUNDING_STRICT=true
BRAIN_LLM_RETRY_MAX_ATTEMPTS=3
BRAIN_LLM_RETRY_BACKOFF_SECONDS=1.0
BRAIN_LLM_SEMAPHORE_SIZE=8

# =============================================================================
# INTEGRATIONS (opt) — GitHub, push notifications, SSO
# =============================================================================

# Segreto webhook GitHub.
GITHUB_WEBHOOK_SECRET=<<API_KEY>>

# Web Push VAPID (chiavi push notification browser).
VAPID_PRIVATE_KEY=<<API_KEY>>
VAPID_PUBLIC_KEY=<<API_KEY>>

# WorkOS SSO (lascia SSO_ENABLED=false se non usi SSO enterprise).
WORKOS_API_KEY=<<API_KEY>>
WORKOS_CLIENT_ID=<<CLIENT_ID>>
WORKOS_COOKIE_PASSWORD=<<COOKIE_PASSWORD>>
SSO_ENABLED=false

# =============================================================================
# CONSOLE UI (opt) — branding & feature flags Next.js
# =============================================================================

NEXT_PUBLIC_WEBUI_NAME=Marvis
NEXT_PUBLIC_LOGO_URL=
NEXT_PUBLIC_PRIMARY_HSL="220 70% 45%"
NEXT_PUBLIC_FAVICON_HREF=/favicon.svg

# Build-time URL: usati a build per Next.js, devono puntare alla API esposta.
NEXT_PUBLIC_API_URL=http://localhost:8100
NEXT_PUBLIC_WS_URL=ws://localhost:8100
NEXT_PUBLIC_DIRECT_WS_URL=ws://localhost:8100
NEXT_PUBLIC_DIRECT_WS_PROBE_URL=http://localhost:8100/health
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# Knowledge Graph UI feature flags.
NEXT_PUBLIC_ENABLE_GRAPH_UX=false
NEXT_PUBLIC_ENABLE_GRAPH_CANVAS=false
NEXT_PUBLIC_ENABLE_GRAPH_UNIVERSE=false

# =============================================================================
# LIFEOS (opt) — personal-data git sync layer
# =============================================================================

LIFEOS_DATA_DIR=
LIFEOS_GIT_REPO_DIR=
LIFEOS_GIT_SYNC_INTERVAL=30

# =============================================================================
# PR IMPACT (opt) — Knowledge Graph blast-radius pipeline
# =============================================================================

PR_IMPACT_ENABLED=shadow
FUNCTION_CAP_DEFAULT=800
FUNCTION_CAP_MAX_DEEP_LINK=50
KG_BRANCH_STALE_DAYS=30
PR_EVENTS_REPLAY_MAXLEN=20
KG_HTTP_DEEP_DEFAULT=false

# =============================================================================
# ADVANCED (opt) — multi-tenant & UID isolation (lascia false su single-tenant)
# =============================================================================

MULTI_TENANT_ENABLED=false
PER_USER_API_KEY_ENABLED=false

# Master secret for encrypting BYOK provider keys at rest (Fernet/HKDF).
# Required when BYOK provider keys or per-user API keys are used.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
BYOK_FERNET_SECRET=
FERNET_SALT_VERSION=v1

UID_ISOLATION_ENABLED=false
UID_POOL_SIZE=0
UID_POOL_PREFIX=tenant
UID_POOL_BASE=10100

# Path estensione SQLite vec0 (vector search). Lascia default se non usi.
VEC0_PATH=/data/pir/lib/vec0
