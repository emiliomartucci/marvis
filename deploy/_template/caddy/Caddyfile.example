# deploy/_template/caddy/Caddyfile.example
#
# Single source of truth for the Marvis Caddy reverse proxy.
# Used by:
#   - docker-compose.yml `caddy` profile (env vars from .env at container start)
#   - core/scripts/lib/setup-server/proxy-caddy.sh (host install, env from
#     /etc/default/caddy written during setup)
#
# Env vars consumed (Caddy native {$VAR} syntax, resolved at start time):
#   PUBLIC_DOMAIN            primary hostname; "localhost" triggers Caddy
#                            internal CA (no Let's Encrypt). Default: localhost.
#   ACME_EMAIL               account email for Let's Encrypt. Ignored when
#                            PUBLIC_DOMAIN=localhost. Default: admin@example.com.
#   MARVIS_API_UPSTREAM      backend for /api, /ws, /terminal, /health routes.
#                            Default: 127.0.0.1:8100 (host install).
#                            Compose override: api:8100.
#   MARVIS_CONSOLE_UPSTREAM  backend for the catch-all SPA route.
#                            Default: 127.0.0.1:3000 (host install).
#                            Compose override: console:3000.
#
# Pre-flight for prod: DNS A/AAAA records for $PUBLIC_DOMAIN must resolve to
# this host before the first request (Let's Encrypt http-01 challenge).

{
	email {$ACME_EMAIL:admin@example.com}
}

{$PUBLIC_DOMAIN:localhost} {
	encode gzip

	# Health probe (used by deploy scripts + uptime monitors)
	@health path /health
	handle @health {
		reverse_proxy {$MARVIS_API_UPSTREAM:127.0.0.1:8100} {
			header_up -CF-Connecting-IP
			header_up X-Marvis-Client-IP {http.request.remote.host}
		}
	}

	# API surface (FastAPI)
	@api path /api/*
	handle @api {
		reverse_proxy {$MARVIS_API_UPSTREAM:127.0.0.1:8100} {
			header_up -CF-Connecting-IP
			header_up X-Marvis-Client-IP {http.request.remote.host}
		}
	}

	# Websocket main channel
	@ws path /ws/*
	handle @ws {
		reverse_proxy {$MARVIS_API_UPSTREAM:127.0.0.1:8100} {
			header_up -CF-Connecting-IP
			header_up X-Marvis-Client-IP {http.request.remote.host}
		}
	}

	# Terminal websocket
	@terminal path /terminal/*
	handle @terminal {
		reverse_proxy {$MARVIS_API_UPSTREAM:127.0.0.1:8100} {
			header_up -CF-Connecting-IP
			header_up X-Marvis-Client-IP {http.request.remote.host}
		}
	}

	# Console SPA (Next.js) — catch-all
	handle {
		reverse_proxy {$MARVIS_CONSOLE_UPSTREAM:127.0.0.1:3000}
	}
}
